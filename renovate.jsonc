{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "extrange/renovate-config:exceptMajor"
  ],
  // Do not update this project's compose.yml file
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/extrange/polythought"
      ],
      "enabled": false
    }
  ]
}
