# Copy this file to .env and fill in the required values:
#
#   cp .env.example .env
#
# Compose loads .env automatically. Only secrets live here: everything else has
# a default in src/polythought/settings.py or is inlined in compose.yml.

# --- Required ---------------------------------------------------------------
# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=
# Bot token from @BotFather
BOT_TOKEN=
